// Export units built from UnitContent (1–5) as a student script plus a feedback key, for persona walkthroughs.
// Usage: npx tsx tools/sim/export-units.mts en|de <outdir> 1,2,3
import { writeFileSync } from 'node:fs';
import { GLOSSARY } from '../../src/content/glossary';
import { MISCONCEPTIONS } from '../../src/content/curriculum';
import type { Item } from '../../src/content/items';
import type { UnitContent, Show, DataTable } from '../../src/content/unitTypes';
import type { Extra, Reading } from '../../src/content/unit06';
import type { Bi } from '../../src/i18n';
import { byZ } from '../../src/content/elements';
import { substance, CONDUCTIVITY } from '../../src/content/substances';

const lang = (process.argv[2] ?? 'en') as 'en' | 'de';
const out = process.argv[3] ?? '.';
const units = (process.argv[4] ?? '1,2,3,4,5').split(',').map(Number);
const contents: UnitContent[] = [];
for (const n of units) contents.push((await import(`../../src/content/unit${String(n).padStart(2, "0")}.ts`))[`UNIT${n}`]);
await import('../../src/content/registry');
for (const U of contents) for (const m of U.misconceptions) if (!MISCONCEPTIONS.some((x) => x.id === m.id)) MISCONCEPTIONS.push({ ...m, unit: U.n });
for (const U of contents) Object.assign(GLOSSARY, U.glossary);

const SUB = '₀₁₂₃₄₅₆₇₈₉', SUP: Record<string, string> = { '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹', '+': '⁺', '-': '⁻' };
const L = (b: Bi | string) => (typeof b === 'string' ? b : b[lang]);
const formula = (f: string) => {
  const m = /^(.*?)(\d?)([+-])$/.exec(f);
  let body = f, charge = '';
  if (m) { const [, b, d, sg] = m; if (d && (/^[A-Z][a-z]?$/.test(b) || /\d$/.test(b))) { body = b; charge = d + sg; } else { body = b + d; charge = sg; } }
  return body.replace(/\d/g, (d) => SUB[+d]) + charge.split('').map((c) => SUP[c] ?? c).join('');
};
const plain = (b: Bi | string) => L(b)
  .replace(/\{\{([^}]+)\}\}/g, (_, f) => formula(f))
  .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, '$2')
  .replace(/\[\[([^\]]+)\]\]/g, (_, id) => (GLOSSARY[id] ? L({ en: GLOSSARY[id].en, de: GLOSSARY[id].de }) : id))
  .replace(/_\{([^}]+)\}/g, '_$1').replace(/\*\*([^*]+)\*\*/g, '$1');
const T = (en: string, de: string) => (lang === 'en' ? en : de);
const letters = 'ABCDEFG';
const q: string[] = [];
const k: string[] = [];
const H = (s: string) => q.push(`\n## ${s}\n`);
const P = (s: string) => q.push(s);
const MIN = [3, 3, 7, 4, 5, 4, 1];
const left = (step: number) => T(` (header: "about ${MIN.slice(step).reduce((a, b) => a + b, 0)} min left, saved after every step")`, ` (Kopfzeile: „noch etwa ${MIN.slice(step).reduce((a, b) => a + b, 0)} Min., gespeichert nach jedem Schritt“)`);
const misName = (id: string) => { const m = MISCONCEPTIONS.find((x) => x.id === id); return m ? L(m.name) : id; };

function question(it: Item, label: string) {
  // The app shows no label of its own when the prompt already starts with it ("Kurzer Check: …").
  const head = label.replace(/\s*\((optional|freiwillig)\)/, '').replace(/[.:]$/, '');
  if (head && plain(it.prompt).startsWith(head)) label = '';
  q.push(`\n**[${it.id}]${label ? ' ' + label : ''}** ${plain(it.prompt)}`);
  if (it.format === 'why') q.push(T('  (Format: pick the best explanation.)', '  (Format: die beste Erklärung wählen.)'));
  if (it.table) q.push(T(`  (A "Look it up in the table" button opens the periodic table with the "${it.table}" view.)`, `  (Ein Knopf „Im Periodensystem nachsehen“ öffnet das Periodensystem mit der passenden Ansicht.)`));
  if (it.kind === 'choice') {
    it.options.forEach((o, i) => q.push(`  ${letters[i]}. ${plain(o.text)}`));
    if (it.withConfidence) q.push(T('  Confidence slider "How sure are you?": 50 % (guessing) to 100 % (certain).', '  Regler „Wie sicher bist du?“: 50 % (geraten) bis 100 % (sicher).'));
    const ci = it.options.findIndex((o) => o.correct);
    const traps = it.options.map((o, i) => (o.mis ? `${letters[i]} (${misName(o.mis)})` : '')).filter(Boolean);
    k.push(`- [${it.id}] ${T('Correct', 'Richtig')}: ${letters[ci]}. ${plain(it.explain)}`
      + (traps.length ? ' ' + T(`Trap options: ${traps.join('; ')}. If one is chosen, the app adds "A common trap: <name>. The app will bring it back on another day until it sticks."`, `Fallen: ${traps.join('; ')}. Wer eine wählt, sieht „Eine häufige Falle: <Name>. Da tappen viele hinein. Die App fragt das an einem anderen Tag noch einmal ab, bis es sitzt.“`) : ''));
  } else if (it.kind === 'rank') {
    const n = it.order.length;
    const perm = n === 3 ? [1, 2, 0] : n === 4 ? [2, 0, 3, 1] : it.order.map((_, i) => (i * 2 + 1) % n);
    q.push(T('  Put in order (drag rows). Starting order shown: ', '  In Reihenfolge bringen (Zeilen ziehen). Startreihenfolge: ') + perm.map((i) => plain(it.order[i])).join(', '));
    k.push(`- [${it.id}] ${T('Correct order', 'Richtige Reihenfolge')}: ${it.order.map((x, i) => `${i + 1}. ${plain(x)}`).join('  ')}. ${plain(it.explain)}`);
  } else if (it.kind === 'estimate') {
    q.push(T(`  Slider from ${it.min} to ${it.max}${it.suffix} in steps of ${it.step}.`, `  Regler von ${String(it.min).replace('.', ',')} bis ${String(it.max).replace('.', ',')}${it.suffix} in Schritten von ${String(it.step).replace('.', ',')}.`));
    const close = +Math.max(it.tolerance * 3, (it.max - it.min) * 0.06, it.step).toFixed(2);
    k.push(`- [${it.id}] ${T('Answer', 'Lösung')}: ${it.answer}${it.suffix}. ${T(`"Spot on." within ±${it.tolerance}, "Close." within ±${close}, otherwise "Far off."`, `„Genau richtig.“ innerhalb ±${it.tolerance}, „Nah dran.“ innerhalb ±${close}, sonst „Weit daneben.“`)} ${plain(it.explain)}`
      + (it.near ?? []).map((nn) => ' ' + T(`Near ${nn.value} (±${nn.tol}) the app adds: `, `Nahe ${nn.value} (±${nn.tol}) ergänzt die App: `) + plain(nn.note)).join(''));
  } else if (it.kind === 'flaw') {
    it.lines.forEach((l, i) => q.push(`  ${i + 1}. ${plain(l)}`));
    k.push(`- [${it.id}] ${T('First wrong step', 'Erster falscher Schritt')}: ${it.flaw + 1}.`
      + (it.alsoFalse ? ' ' + (it.alsoFalse.length === 1 ? T(`Step ${it.alsoFalse[0] + 1} counts as partly right (false only because it follows from the slip).`, `Schritt ${it.alsoFalse[0] + 1} zählt als teilweise richtig (nur falsch, weil er aus dem Fehler folgt).`) : T(`Steps ${it.alsoFalse.slice(0, -1).map((x) => x + 1).join(', ')} and ${it.alsoFalse.at(-1)! + 1} count as partly right (false only because they follow from the slip).`, `Die Schritte ${it.alsoFalse.slice(0, -1).map((x) => x + 1).join(', ')} und ${it.alsoFalse.at(-1)! + 1} zählen als teilweise richtig (nur falsch, weil sie aus dem Fehler folgen).`)) : '')
      + (it.near ?? []).map((nn) => ' ' + T(`Step ${nn.step + 1} gets the note: `, `Schritt ${nn.step + 1} bekommt den Hinweis: `) + plain(nn.note)).join('')
      + ` ${plain(it.explain)}`);
  }
}
const extra = (id: string, x: Extra) => k.push(`- ${T(`If [${id}] was answered wrong, before the reveal: "One more way to see it"`, `Wenn [${id}] falsch war, vor der Auflösung: „Noch ein Weg, es zu sehen“`)}: **${plain(x.title)}**: ${x.steps.map((st, i) => `${i + 1}. ${plain(st)}`).join(' ')}`);
const readingsOut = (rs: Reading[]) => rs.filter((r) => r.lang === lang).forEach((R) => P(`${T('Read tonight', 'Lesestoff')}${R.kind ? ` (${R.kind === 'quick' ? T('quick read', 'kurz') : T('deeper', 'vertiefend')})` : ''}: ${L(R.title)} (${R.source}, ${R.url}). ${T('Things to look for', 'Worauf du achten kannst')}: ${R.lookFor.map(plain).join(' / ')}`));
const table = (d: DataTable) => {
  const num = new Set(d.numeric ?? []);
  const row = (cells: (string | Bi)[], isData = false) => '| ' + cells.map((c, i) => (isData && num.has(i) && typeof c === 'string' && lang === 'de' ? plain(c).replace(/(\d)\.(\d)/g, '$1,$2') : plain(c))).join(' | ') + ' |';
  if (d.caption) P(plain(d.caption));
  P(row(d.head)); P('|' + d.head.map(() => '---').join('|') + '|');
  d.rows.forEach((r) => P(row(r.cells, true) + (r.mystery ? T(' ← highlighted', ' ← hervorgehoben') : '')));
};
const showText = (s: Show) => {
  const who = (s.engine === 'atom') ? (() => { const e = byZ(s.z!); const nm = lang === "de" ? e.de : e.en; if (!s.charge) return T(`the ${nm} atom`, `ein ${nm}-Atom`); const ion = formula(`${e.s}${Math.abs(s.charge) > 1 ? Math.abs(s.charge) : ''}${s.charge > 0 ? '+' : '-'}`); return T(`the ion ${ion}`, `das Ion ${ion}`); })() : '';
  if (s.engine === 'atom') return T(`the Orbital Viewer shows ${who}${s.view ? `, ${s.view} picture` : ''}${s.highlight ? `, ${s.highlight} highlighted` : ''}${s.pull ? `, ${s.pull} electrons pulled off with their energies as bars` : ''}${s.jump ? `, the ${s.jump[0]}→${s.jump[1]} jump played` : ''}${s.size ? ', drawn at measured size with its radius in pm' : ''}`,
    `der Orbital-Betrachter zeigt ${who}${s.view ? `, Darstellung ${s.view === 'clouds' ? 'Orbitalwolken' : 'Schalen'}` : ''}${s.highlight ? `, ${s.highlight} hervorgehoben` : ''}${s.pull ? `, ${s.pull} Elektronen abgezogen, ihre Energien als Balken` : ''}${s.jump ? `, der Sprung ${s.jump[0]}→${s.jump[1]}` : ''}${s.size ? ', in gemessener Größe mit Radius in pm' : ''}`);
  if (s.engine === 'lattice') return T(`the Lattice Builder loads ${formula(s.salt)}${s.compare ? ` and compares it with ${formula(s.compare)} in the gauge` : ''}${s.mode ? ` (${({ transfer: 'makes the ions', shift: 'shifts a layer', heat: 'heats it', neighbours: 'shows the centre ion and its neighbours' } as Record<string, string>)[s.mode]})` : ''}${s.temp !== undefined ? ` at ${s.temp} °C` : ''}`, `der Gitterbaukasten lädt ${formula(s.salt)}${s.compare ? ` und vergleicht mit ${formula(s.compare)}` : ''}${s.mode ? ` (${({ transfer: 'Ionen bilden', shift: 'Schicht verschieben', heat: 'erhitzen', neighbours: 'Nachbarn zeigen' } as Record<string, string>)[s.mode]})` : ''}${s.temp !== undefined ? ` bei ${s.temp} °C` : ''}`);
  if (s.engine === 'conduct') { const nm = CONDUCTIVITY[s.material].name; return T(`the conductivity tester shows ${nm.en}${s.on ? ' with the battery connected' : ''}${s.reversed ? ', poles swapped' : ''}`, `der Leitfähigkeitsprüfer zeigt ${nm.de}${s.on ? ' mit angeschlossener Batterie' : ''}${s.reversed ? ', Pole vertauscht' : ''}`); }
  if (s.engine === 'box') { const sub = (id: string) => (id === 'NaCl' ? T('salt', 'Salz') : id === 'ice' ? T('a piece of ice', 'ein Stück Eis') : `${formula(substance(id).formula)} (${L(substance(id).name)})`); const v = s.view && s.view !== 'plain' ? T(`, ${({ clouds: 'electron clouds', dipoles: 'dipoles', hbonds: 'hydrogen bonds' } as Record<string, string>)[s.view]} shown`, `, ${({ clouds: 'Elektronenwolken', dipoles: 'Dipole', hbonds: 'Wasserstoffbrücken' } as Record<string, string>)[s.view]} eingeblendet`) : ''; return T(`the Particle Box shows ${sub(s.sub)}${s.mix ? ` with ${sub(s.mix)} poured in` : ''}${s.compare ? ` next to ${sub(s.compare)}` : ''} at ${s.temp ?? 20} °C${v}${s.dipoleOff ? ', dipole switched off (what-if)' : ''}`, `die Teilchenbox zeigt ${sub(s.sub)}${s.mix ? ` mit ${s.mix === 'ice' ? 'einem Stück Eis' : sub(s.mix)} dazugegeben` : ''}${s.compare ? ` neben ${sub(s.compare)}` : ''} bei ${s.temp ?? 20} °C${v}${s.dipoleOff ? ', Dipol ausgeschaltet (Was-wäre-wenn)' : ''}`); }
  if (s.engine === 'hbond') { const m = (id: string) => formula(substance(id)?.formula ?? id); return s.cluster ? T('the hydrogen-bond view shows water with four neighbours', 'die Wasserstoffbrücken-Ansicht zeigt Wasser mit vier Nachbarn') : T(`the hydrogen-bond view shows ${m(s.a)}${s.b ? ` with ${m(s.b)}${s.swap ? ', roles swapped' : ''}` : ''}`, `die Wasserstoffbrücken-Ansicht zeigt ${m(s.a)}${s.b ? ` mit ${m(s.b)}${s.swap ? ', Rollen getauscht' : ''}` : ''}`); }
  return T(`the Charge Field shows the ${s.a}${s.order === 2 ? '=' : s.order === 3 ? '≡' : '–'}${s.b} bond`, `das Ladungsfeld zeigt die Bindung ${s.a}${s.order === 2 ? '=' : s.order === 3 ? '≡' : '–'}${s.b}`);
};

const ENGINE: Record<number, Bi> = {
  1: { en: 'The Orbital Viewer: one atom in 3D, nucleus labelled with its charge (e.g. "11+"). Two pictures: "Shells (Bohr picture)" with rings and electron dots labelled "n = 1: 2", and "Orbital clouds" with translucent lobes (s spheres, p dumbbells, d clovers; inner shells faint). A slider for the element (Z = 1–36) and buttons "◀ previous element" and "Next: + 1 proton, + 1 electron ▶" (the newest electron glows). The HUD shows symbol, name, Z, the configuration (e.g. 1s² 2s² 2p⁶ 3s¹) and "shells 2 · 8 · 1". An orbital box diagram (lowest energy at the bottom, arrows ↑↓, "2/6" counts; tapping a row highlights that subshell\'s cloud). A panel "Hydrogen\'s energy levels": a ladder n = 1…6 with energies in eV (axis broken below n = 2), buttons for the jumps 3→2, 4→2, 5→2, 6→2, 2→1, 4→3; each jump draws an arrow in the colour of the light and prints e.g. "n=3 → n=2: 1.89 eV, 656 nm, visible light", and adds a line to a spectrum strip (400–700 nm). Ultraviolet and infrared jumps are drawn dashed and called invisible.', de: 'Der Orbital-Betrachter: ein Atom in 3D, der Kern mit seiner Ladung beschriftet (z. B. „11+“). Zwei Darstellungen: „Schalenmodell“ mit Ringen und Elektronenpunkten, beschriftet „n = 1: 2“, und „Orbitalwolken“ mit durchscheinenden Keulen (s Kugeln, p Hanteln, d Kleeblätter; innere Schalen blass). Ein Regler für das Element (Z = 1–36) und Knöpfe „◀ voriges Element“ und „Weiter: + 1 Proton, + 1 Elektron ▶“ (das neueste Elektron leuchtet). Oben stehen Symbol, Name, Z, die Konfiguration (z. B. 1s² 2s² 2p⁶ 3s¹) und „Schalen 2 · 8 · 1“. Ein Kästchendiagramm (niedrigste Energie unten, Pfeile ↑↓, Zähler „2/6“; Antippen einer Zeile hebt die Wolke dieser Unterschale hervor). Ein Feld „Die Energieniveaus von Wasserstoff“: eine Leiter n = 1…6 mit Energien in eV (Achse unter n = 2 unterbrochen), Knöpfe für die Sprünge 3→2, 4→2, 5→2, 6→2, 2→1, 4→3; jeder Sprung zeichnet einen Pfeil in der Farbe des Lichts und meldet z. B. „n=3 → n=2: 1,89 eV, 656 nm, sichtbares Licht“ und setzt eine Linie in einen Spektralstreifen (400–700 nm). Ultraviolette und infrarote Sprünge sind gestrichelt und als unsichtbar bezeichnet.' },
  2: { en: 'The Orbital Viewer in size mode: the shells picture drawn at the measured size (outer shell at the measured radius; inner shells smaller, not to scale), with a readout "radius 180 pm" (or "ion radius 102 pm"). An element slider (Z = 1–36) with "◀ previous element" / "Next ▶". A row "Make an ion (tap again to go back to the atom)": Na⁺, K⁺, Mg²⁺, Al³⁺, F⁻, O²⁻, Cl⁻. A slider "How well the inner electrons shield" from 0 to 100 % with the line "Z_eff ≈ Z − shielding × inner electrons · Z_eff ≈ 1.0"; lowering it makes the atom shrink as the outer electrons feel more of the nucleus.', de: 'Der Orbital-Betrachter in Größenansicht: das Schalenbild in gemessener Größe (Außenschale beim gemessenen Radius; innere Schalen kleiner, nicht maßstabsgetreu), mit der Anzeige „Radius 180 pm“ (oder „Ionenradius 102 pm“). Ein Elementregler (Z = 1–36) mit „◀ voriges Element“ / „Weiter ▶“. Eine Zeile „Ion bilden (noch einmal tippen: zurück zum Atom)“: Na⁺, K⁺, Mg²⁺, Al³⁺, F⁻, O²⁻, Cl⁻. Ein Regler „Wie gut die inneren Elektronen abschirmen“ von 0 bis 100 % mit der Zeile „Z_eff ≈ Z − Abschirmung × innere Elektronen · Z_eff ≈ 1,0“; senkt man ihn, schrumpft das Atom, weil die Außenelektronen mehr vom Kern spüren.' },
  3: { en: 'The Orbital Viewer with an ionization panel: one atom (Z = 1–20) as shells or clouds, the orbital boxes, and "Pull off the outermost electron". Each pull removes one electron (the HUD shows the ion, e.g. Mg²⁺, and its configuration) and adds a bar with the energy it cost in kJ/mol; only the biggest jump in the series (the cliff) is drawn red. "3 electrons pulled off, 9921 kJ/mol in all." "Put them all back" resets.', de: 'Der Orbital-Betrachter mit einem Ionisierungsfeld: ein Atom (Z = 1–20) als Schalen oder Wolken, die Orbitalkästchen und „Das äußerste Elektron abziehen“. Jedes Antippen entfernt ein Elektron (oben steht das Ion, z. B. Mg²⁺, und seine Konfiguration) und fügt einen Balken mit der Energie in kJ/mol hinzu; nur der größte Sprung der Reihe (der Absturz) wird rot. „3 Elektronen abgezogen, insgesamt 9921 kJ/mol.“ „Alle zurücksetzen“ setzt zurück.' },
  4: { en: 'The Lattice Builder: a rotating 5 × 5 × 5 rock-salt crystal, cations blue, anions red, ions drawn a little smaller than their measured size so you can see in. Chips: NaCl, KCl, NaF, NaBr, NaI, LiF, MgO, CaO. "Make the ions": a neutral metal atom and a non-metal atom; one (or two) glowing electrons hop across; the metal shrinks and turns blue, the non-metal grows and turns red; labels change to Na⁺ and Cl⁻. "Show the centre ion" (or tapping any ion): the ion and the ions touching it stay, everything else fades, with a count (6 inside the crystal, fewer on the surface). A temperature slider 0–3000 °C with a mark "melts at 801 °C": the ions jiggle more as it heats; above the melting point the crystal falls apart and the ions wander ("molten: ions free to move"). "Shift a layer": the top layer slides by one ion, yellow lines mark like charges now on top of each other, and the layer lifts off ("like charges side by side: they push apart"). A gauge "How strongly the ions hold on" compares the last two salts: charges (e.g. 2 × 2 = 4), distance (r₊ + r₋ in pm), "model: charges ÷ distance" relative to NaCl with a bar, measured lattice energy (kJ/mol) with a bar, and melting point.', de: 'Der Gitterbaukasten: ein sich drehender Kochsalzkristall aus 5 × 5 × 5 Ionen, Kationen blau, Anionen rot, etwas kleiner gezeichnet als gemessen, damit man hineinsieht. Chips: NaCl, KCl, NaF, NaBr, NaI, LiF, MgO, CaO. „Ionen bilden“: ein neutrales Metallatom und ein Nichtmetallatom; ein (oder zwei) leuchtende Elektronen springen hinüber; das Metall schrumpft und wird blau, das Nichtmetall wächst und wird rot; die Beschriftung wird zu Na⁺ und Cl⁻. „Das mittlere Ion zeigen“ (oder ein Ion antippen): Das Ion und seine direkten Nachbarn bleiben, der Rest verblasst, mit einer Zahl (6 im Inneren, weniger an der Oberfläche). Ein Temperaturregler 0–3000 °C mit Marke „Schmelzpunkt 801 °C“: Die Ionen zittern stärker; über dem Schmelzpunkt zerfällt das Gitter und die Ionen wandern („geschmolzen: Ionen frei beweglich“). „Eine Schicht verschieben“: Die oberste Schicht rutscht um ein Ion, gelbe Linien markieren gleiche Ladungen übereinander, und die Schicht hebt ab („gleiche Ladungen nebeneinander: Sie stoßen sich ab“). Eine Anzeige „Wie stark die Ionen zusammenhalten“ vergleicht die letzten zwei Salze: Ladungen (z. B. 2 × 2 = 4), Abstand (r₊ + r₋ in pm), „Modell: Ladungen ÷ Abstand“ relativ zu NaCl mit Balken, gemessene Gitterenergie (kJ/mol) mit Balken, Schmelzpunkt.' },
  5: { en: 'The Charge Field: two atoms in 3D joined by one to three sticks (one per shared pair), with a haze of faint dots that builds up into a map of where the shared pair is likely to be found, and a few bright dots sampled from it. The cloud leans towards the atom that pulls harder; that atom gets a red halo and "δ−", the other a blue halo and "δ+"; the halo and the stick fade change gradually with the difference. Readout: the bond (e.g. H–Cl, "hydrogen chloride, HCl"), "electronegativity H 2.20 · Cl 3.16", "difference 0.96 · polar", and "δ− slightly negative · δ+ slightly positive" (from about 50 % ionic character: "δ− negative end · δ+ positive end: the pair sits mostly on one atom"). Chips: H–H, Cl–Cl, F–F, H–Cl, H–F, C–H, O–H, N–H, C–O, C=O, O=O, N≡N, C–C, C=C, C≡C, Na–Cl, and "Pick your own pair of atoms" (H, C, N, O, F, Na, Cl). A scale "Electronegativity difference (Δχ)" from 0 to 3.3 with bands nonpolar (to 0.4), polar (to 1.8), ionic, and the note "the borders are rules of thumb". Three boxes: bond length (pm; "≈" if estimated), bond energy (kJ/mol), ionic character "≈ 21 %". A "What if Cl pulled harder or weaker?" slider (electronegativity 0.5–4.5), a fold-out "How the cloud is drawn" (Pauling\'s estimate of the ionic character, 1 − e^(−Δχ²/4); "A model, not a measurement.") and a "Real value" button.', de: 'Das Ladungsfeld: zwei Atome in 3D, verbunden durch ein bis drei Stäbe (einer pro gemeinsamem Paar), mit einem Schleier aus blassen Punkten, der sich zu einer Karte aufbaut, wo das gemeinsame Paar wahrscheinlich anzutreffen ist; ein paar helle Punkte sind Stichproben daraus. Die Wolke neigt sich zum Atom, das stärker zieht; es bekommt einen roten Schein und „δ−“, das andere einen blauen und „δ+“; Schein und Verblassen des Stabs ändern sich allmählich mit der Differenz. Anzeige: die Bindung (z. B. H–Cl, „Chlorwasserstoff, HCl“), „EN H 2,20 · Cl 3,16“, „ΔEN 0,96 · polar“ und „δ− leicht negativ · δ+ leicht positiv“ (ab etwa 50 % Ionencharakter: „δ− negatives Ende · δ+ positives Ende: Das Paar sitzt meist bei einem Atom“). Chips: H–H, Cl–Cl, F–F, H–Cl, H–F, C–H, O–H, N–H, C–O, C=O, O=O, N≡N, C–C, C=C, C≡C, Na–Cl, dazu „Eigenes Atompaar wählen“ (H, C, N, O, F, Na, Cl). Eine Skala „Elektronegativitätsdifferenz (ΔEN)“ von 0 bis 3,3 mit den Bereichen unpolar (bis 0,4), polar (bis 1,8), ionisch, einer gestrichelten Marke „Schulbuch 1,7“ und dem Hinweis „die Grenzen sind Faustregeln; viele Schulbücher setzen sie bei 0,5 und 1,7“. Drei Kästen: Bindungslänge (pm; „≈“ wenn geschätzt), Bindungsenergie (kJ/mol), Ionencharakter „≈ 21 %“. Ein Regler „Was, wenn Cl stärker oder schwächer zöge?“ (EN 0,5–4,5) mit einem Ausklapptext „Wie die Wolke gezeichnet wird“ (Paulings Schätzung des Ionencharakters, 1 − e^(−ΔEN²/4); „Ein Modell, keine Messung.“) und einem Knopf „Echter Wert“.' },
};

ENGINE[7] = { en: 'The conductivity tester: a cell with two grey electrode plates, the left one marked − and the right one + (grey badges), wired to a battery and a lamp. Above the cell: the material\'s name, a one-line description and a legend (e.g. "atom cores (+) · electrons (−)"). Chips: Copper, Salt (solid), Salt water, Sugar water, Pure water; for solid salt a button "Heat past 801 °C" turns it into molten salt ("Let it cool below 801 °C" goes back). Copper: blue atom cores in a lattice with small red-pink electrons darting between them. Solid salt: a rock-salt lattice of blue Na⁺ and red Cl⁻. Molten salt: the same ions jumbled and moving. Salt water: ions spread among many small grey water molecules. Sugar water: small beige clusters (sugar, no charge) among water molecules. Pure water: water molecules only. "Connect the battery": the lamp lights (bright for copper, glowing for molten salt and salt water, off otherwise) and big arrows under the cell show which way carriers drift (e⁻ towards +; Na⁺ towards −, Cl⁻ towards +); a line below says "Charge carriers: electrons / ions / none that can move" (pure water: "very few ions (H₃O⁺, OH⁻)") and "current flows: lamp bright" or "practically no current". "Swap the poles" reverses the drift. A panel "How well it conducts": one row per material on a log scale from 10⁻⁸ to 10⁸ S/m, the current one highlighted ("about 6 × 10⁷ S/m"; solid salt "far below 10⁻¹⁰ S/m"). For pure water a note: about one molecule in 555 million has passed a proton to a neighbour, giving H₃O⁺ and OH⁻.', de: 'Der Leitfähigkeitsprüfer: eine Zelle mit zwei grauen Elektrodenplatten, links −, rechts + (graue Schilder), verbunden mit Batterie und Lampe. Über der Zelle: Name des Stoffs, eine Zeile Beschreibung und eine Legende (z. B. „Atomrümpfe (+) · Elektronen (−)“). Chips: Kupfer, Salz (fest), Salzlösung, Zuckerlösung, Reines Wasser; bei festem Salz macht ein Knopf „Über 801 °C erhitzen“ daraus eine Salzschmelze („Unter 801 °C abkühlen lassen“ führt zurück). Kupfer: blaue Atomrümpfe im Gitter, dazwischen flitzen kleine rot-rosa Elektronen. Festes Salz: ein Ionengitter aus blauen Na⁺ und roten Cl⁻. Schmelze: dieselben Ionen ungeordnet und beweglich. Salzlösung: Ionen verteilt zwischen vielen kleinen grauen Wassermolekülen. Zuckerlösung: kleine beige Haufen (Zucker, ungeladen) zwischen Wassermolekülen. Reines Wasser: nur Wassermoleküle. „Batterie anschließen“: Die Lampe leuchtet (hell bei Kupfer, glimmend bei Schmelze und Salzlösung, sonst aus), große Pfeile unter der Zelle zeigen, wohin die Ladungsträger wandern (e⁻ zu +; Na⁺ zu −, Cl⁻ zu +); darunter „Ladungsträger: Elektronen / Ionen / keine beweglichen“ (reines Wasser: „sehr wenige Ionen (H₃O⁺, OH⁻)“) und „Strom fließt: Lampe hell“ oder „praktisch kein Strom“. „Pole tauschen“ kehrt die Wanderung um. Ein Feld „Wie gut es leitet“: eine Zeile je Stoff auf einer logarithmischen Skala von 10⁻⁸ bis 10⁸ S/m, der aktuelle hervorgehoben („etwa 6 · 10⁷ S/m“; festes Salz „weit unter 10⁻¹⁰ S/m“). Bei reinem Wasser der Hinweis: Etwa eines von 555 Millionen Molekülen hat ein Proton an ein Nachbarmolekül abgegeben, sodass H₃O⁺ und OH⁻ entstehen (Autoprotolyse).' };
ENGINE[8] = { en: 'The Particle Box: a see-through 3D box of molecules of one substance; solids sit as a crystal block, liquids pool on the floor, gases fill the box. Chips "Substance" (He, Ne, Ar, Kr, Xe, F₂, Cl₂, Br₂, I₂, CH₄, C₂H₆, C₃H₈, C₄H₁₀, C₅H₁₂, neopentane, C₆H₁₄, C₈H₁₈) and "Compare with" (none or any of them: a second box beside the first at the same temperature). "What to show": "Just the molecules" or "Electron clouds" (each molecule flickers red δ− / blue δ+ for an instant, neighbours flicker in step: "for an instant: the clouds flicker"). A temperature slider in °C with small marks for each substance\'s boiling point (yellow) and melting point (blue). Under the boxes a card per substance: now (solid / liquid / gas), boiling point, melting point, electrons per molecule, dipole moment.', de: 'Die Teilchenbox: eine durchsichtige 3D-Box mit Molekülen eines Stoffs; Feststoffe sitzen als Kristallblock, Flüssigkeiten sammeln sich am Boden, Gase füllen die Box. Chips „Stoff“ (He, Ne, Ar, Kr, Xe, F₂, Cl₂, Br₂, I₂, CH₄, C₂H₆, C₃H₈, C₄H₁₀, C₅H₁₂, Neopentan, C₆H₁₄, C₈H₁₈) und „Vergleichen mit“ (keiner oder einer davon: eine zweite Box daneben bei gleicher Temperatur). „Was gezeigt wird“: „Nur die Moleküle“ oder „Elektronenwolken“ (jedes Molekül flackert kurz rot δ− / blau δ+, Nachbarn flackern im Gleichtakt: „für einen Augenblick: Die Wolken flackern“). Ein Temperaturregler in °C mit kleinen Marken für Siedepunkt (gelb) und Schmelzpunkt (blau) jedes Stoffs. Unter den Boxen je Stoff eine Karte: jetzt (fest / flüssig / gasförmig), Siedepunkt, Schmelzpunkt, Elektronen pro Molekül, Dipolmoment.' };
ENGINE[9] = { en: 'The Particle Box (see unit 8) with substances C₃H₈, CH₃CHO (acetaldehyde), C₄H₁₀, CH₃COCH₃ (acetone), CH₃OCH₃ (dimethyl ether), CO₂, HCl, HBr, HI, F₂, Ar; views "Just the molecules", "Dipoles" (polar molecules show a red δ− and a blue δ+ end and turn head to tail with their neighbours; heat scrambles them; molecules without a dipole show no ends; for CO₂: "polar bonds, but no dipole: the two δ− ends point in opposite directions and cancel") and "Electron clouds". For acetone, acetaldehyde and dimethyl ether a switch "Switch off the dipole" makes the box behave like a nonpolar twin of similar size (butane or propane), with the card saying "without its dipole: boils at about −0.5 °C, like butane (model estimate)".', de: 'Die Teilchenbox (siehe Einheit 8) mit den Stoffen C₃H₈, CH₃CHO (Acetaldehyd), C₄H₁₀, CH₃COCH₃ (Aceton), CH₃OCH₃ (Dimethylether), CO₂, HCl, HBr, HI, F₂, Ar; Ansichten „Nur die Moleküle“, „Dipole“ (polare Moleküle zeigen ein rotes δ−- und ein blaues δ+-Ende und drehen sich Kopf an Schwanz zu ihren Nachbarn; Wärme bringt sie durcheinander; Moleküle ohne Dipol zeigen keine Enden; bei CO₂: „polare Bindungen, aber kein Dipol: Die beiden δ−-Enden zeigen in entgegengesetzte Richtungen und heben sich auf“) und „Elektronenwolken“. Für Aceton, Acetaldehyd und Dimethylether macht ein Schalter „Dipol ausschalten“ die Box zu einem unpolaren Zwilling ähnlicher Größe (Butan oder Propan); die Karte sagt dann „ohne Dipol: siedet bei etwa −0,5 °C, wie Butan (Modellschätzung)“.' };
ENGINE[10] = { en: 'The hydrogen-bond view: one small molecule in 3D as balls and sticks. Every H on N, O or F has a blue halo (donor, δ+); every lone pair on N, O or F is a purple lobe (acceptor); legend "blue halo: donor H (δ+) · purple lobe: lone pair (acceptor) · dashes: hydrogen bond". A line counts them, e.g. "Donors: 2 (H on O) · Acceptors: 2 lone pairs on O". Chips "Molecule" (H₂O, NH₃, HF, CH₄, CH₃OH, C₂H₅OH, CH₃OCH₃, CH₃COCH₃, HCl, H₂S) and "Partner molecule" (none or one of them): the partner is docked along the best hydrogen bond (O–H···O nearly straight, a dashed line labelled "hydrogen bond, about 190 pm", next to "O–H bond, 96 pm"), with a sentence saying who donates and who accepts; if no hydrogen bond is possible the partner just sits nearby and a sentence explains why (e.g. no H on N, O or F); with HCl or H₂S it says "Only a weak hydrogen bond: chlorine is strongly electronegative but large. Like most school books, this view draws only the strong hydrogen bonds on N, O and F." "Swap roles" shows the other direction where both work. "Water with four neighbours" builds the cluster in which one water molecule donates two and accepts two hydrogen bonds. Three boxes: O–H bond 96 pm, hydrogen bond H···O ≈ 190 pm, X–H···Y angle ≈ 180°.', de: 'Die Wasserstoffbrücken-Ansicht: ein kleines Molekül in 3D als Kugeln und Stäbe. Jedes H an N, O oder F hat einen blauen Ring (Donor, δ+); jedes freie Elektronenpaar an N, O oder F ist eine lila Keule (Akzeptor); Legende „blauer Ring: Donor-H (δ+) · lila Keule: freies Elektronenpaar (Akzeptor) · Striche: Wasserstoffbrücke“. Eine Zeile zählt sie, z. B. „Donoren: 2 (H an O) · Akzeptoren: 2 freie Paare an O“. Chips „Molekül“ (H₂O, NH₃, HF, CH₄, CH₃OH, C₂H₅OH, CH₃OCH₃, CH₃COCH₃, HCl, H₂S) und „Partnermolekül“ (keins oder eines davon): Der Partner wird entlang der besten Wasserstoffbrücke angedockt (O–H···O fast gerade, eine gestrichelte Linie „Wasserstoffbrücke, etwa 190 pm“ neben „O–H-Bindung, 96 pm“), mit einem Satz, wer spendet und wer annimmt; ist keine Wasserstoffbrücke möglich, liegt der Partner nur daneben, und ein Satz erklärt warum (z. B. kein H an N, O oder F); bei HCl oder H₂S heißt es „Nur eine schwache Wasserstoffbrücke: Chlor ist zwar stark elektronegativ, aber groß. Diese Ansicht zeigt, wie die meisten Schulbücher, nur die starken Wasserstoffbrücken an N, O und F.“ „Rollen tauschen“ zeigt die andere Richtung, wenn beide Moleküle Donor und Akzeptor sein können. „Wasser mit vier Nachbarn“ baut die Gruppe, in der ein Wassermolekül zwei Wasserstoffbrücken spendet und zwei annimmt. Drei Kästen: O–H-Bindung 96 pm, Wasserstoffbrücke H···O ≈ 190 pm, Winkel X–H···Y ≈ 180°.' };
ENGINE[11] = { en: 'The Particle Box with water (see unit 8): bent water molecules (an O body with a reddish δ− tint, two small H with a bluish δ+ tint). Views "Just the molecules" and "Hydrogen bonds" (dashed lines between a donor H and an acceptor O; a readout of hydrogen bonds per molecule in this model). Below 0 °C the water freezes into an open network (drawn a little more open than real ice; the card gives the density of ice 0.917 against 1.000 g/cm³). "Pour into the water": nothing, hexane (C₆H₁₄: forms a layer on top), ethanol (mixes completely), 1-butanol (a little mixes in, most forms a layer on top), salt (a small crystal of blue Na⁺ and red Cl⁻ on the floor; ions leave it one by one and gather turned water molecules around them; "ions dissolved: n of N"; below 0 °C nothing dissolves), a piece of ice (floats with its top at the surface). The card shows density, solubility in water and "poured in".', de: 'Die Teilchenbox mit Wasser (siehe Einheit 8): gewinkelte Wassermoleküle (ein O-Körper mit rötlicher δ−-Tönung, zwei kleine H mit bläulicher δ+-Tönung). Ansichten „Nur die Moleküle“ und „Wasserstoffbrücken“ (gestrichelte Linien zwischen einem Donor-H und einem Akzeptor-O; eine Anzeige der Wasserstoffbrücken pro Molekül in diesem Modell). Unter 0 °C gefriert das Wasser zu einem offenen Netzwerk (etwas offener gezeichnet als echtes Eis; die Karte nennt die Dichte von Eis 0,917 gegenüber 1,000 g/cm³). „Ins Wasser geben“: nichts, Hexan (C₆H₁₄: bildet oben eine Schicht), Ethanol (mischt sich vollständig), 1-Butanol (ein wenig mischt sich, der Rest bildet oben eine Schicht), Salz (ein kleiner Kristall aus blauen Na⁺ und roten Cl⁻ am Boden; Ionen lösen sich einzeln und sammeln ausgerichtete Wassermoleküle um sich; „Gelöste Ionen: n von N“; unter 0 °C löst sich nichts), ein Stück Eis (schwimmt, die Oberseite an der Oberfläche). Die Karte zeigt Dichte, Löslichkeit in Wasser und „dazugegeben“.' };

const explainHow = T('A text box and a confidence slider; then the key ideas as checkboxes ("Tick each idea your text really states"); then "Compare with a tightened version": quiet hints only where ticks and text seem to disagree, a "Revise my text" button, a "Show a tightened version" button and "Save to journal". Nothing is graded.', 'Ein Textfeld und ein Sicherheitsregler; dann die Kernideen als Kästchen („Hake jede Idee ab, die dein Text wirklich enthält“); dann „Mit einer Musterformulierung vergleichen“: leise Hinweise nur, wo Häkchen und Text nicht zusammenpassen, ein Knopf „Meinen Text überarbeiten“, „Musterformulierung zeigen“ und „Im Lerntagebuch speichern“. Nichts wird bewertet.');

q.push(T(`# Orbitarium — student script for units ${units.join(', ')}\n\nWhat the app shows, step by step. Simulations are described in words. Answer each question before reading the feedback key.`, `# Orbitarium – Ablauf für Lernende, Einheiten ${units.join(', ')}\n\nSo zeigt es die App, Schritt für Schritt. Simulationen sind in Worten beschrieben. Beantworte jede Frage, bevor du im Feedback-Schlüssel nachsiehst.`));
for (const U of contents) {
  q.push(`\n\n# ${T('Unit', 'Einheit')} ${U.n}: ${L(U.title)}\n\n${plain(U.lead)}`);
  k.push(`\n## ${T('Unit', 'Einheit')} ${U.n}`);
  H(T('Step 1 of 7 · Warm-up', 'Schritt 1 von 7 · Aufwärmen') + left(0));
  P(T('Review questions from earlier units (three to eight, picked from what is fading). Not part of this script.', 'Wiederholungsfragen aus früheren Einheiten (drei bis acht, ausgewählt nach dem, was verblasst). Nicht Teil dieses Ablaufs.'));
  H(T('Step 2 of 7 · Puzzle', 'Schritt 2 von 7 · Rätsel') + left(1));
  P(`### ${L(U.puzzle.title)}\n${plain(U.puzzle.lead)}`);
  table(U.puzzle.data);
  P(plain(U.puzzle.clash));
  question(U.puzzle.question, '');
  k.push(`- ${T('After the puzzle', 'Nach dem Rätsel')}: ${plain(U.puzzle.after)}`);
  H(`${T('Step 3 of 7 · Explore', 'Schritt 3 von 7 · Erkunden')}: ${L(U.explore.title)}${left(2)}`);
  P(plain(U.explore.intro));
  P(L(ENGINE[U.n]));
  P(T('Things to try. "Tasks marked key unlock Continue; the others are there if you are curious. Each task ticks itself once you have done it." Once all key tasks (and at least three) are ticked, a quick check appears.', 'Zum Ausprobieren. „Die mit ‚wichtig‘ markierten Aufgaben schalten ‚Weiter‘ frei, die anderen sind für Neugierige. Erledigte Aufgaben werden automatisch abgehakt.“ Sind alle wichtigen Aufgaben (und mindestens drei) abgehakt, erscheint ein kurzer Check.'));
  U.explore.tasks.forEach((t) => P(`- ${t.key ? T('[KEY] ', '[WICHTIG] ') : t.challenge ? '[BONUS] ' : ''}${plain(t.text)}`));
  for (const [id, n] of Object.entries(U.explore.notes ?? {})) k.push(`- ${T(`Note when task "${id}" is ticked`, `Hinweis, wenn Aufgabe „${id}“ abgehakt ist`)}: ${plain(n)}`);
  question(U.explore.check, T('Quick check.', 'Kurzer Check.'));
  H(T('Step 4 of 7 · Predict', 'Schritt 4 von 7 · Vorhersagen') + left(3));
  P(T('Commit to an answer before the simulation shows you.', 'Lege dich fest, bevor die Simulation es zeigt.'));
  U.predictions.forEach((p, i) => {
    question(p.item, T(`Prediction ${i + 1}.`, `Vorhersage ${i + 1}.`));
    extra(p.item.id, p.extra);
    k.push(`- ${T('Reveal', 'Auflösung')} [${p.item.id}]: ${showText(p.show)}. ${plain(p.revealText)}`);
  });
  H(T('Step 5 of 7 · Worked examples', 'Schritt 5 von 7 · Beispiele') + left(4));
  P(T('A compact engine sits above three example cards, each with a "Show in 3D" button.', 'Über drei Beispielkarten sitzt eine kompakte Simulation; jede Karte hat einen Knopf „In 3D zeigen“.'));
  U.examples.forEach((ex) => { P(`\n**${plain(ex.title)}** (${formula(ex.tag)}) — ${ex.numbers.map((n) => `${lang === 'de' ? n.v.replace(/(\d)\.(\d)/g, '$1,$2').replace(/ × 10/g, ' · 10') : n.v} ${plain(n.label)}`).join(', ')}`); P(`  ${plain(ex.body)}`); P(`  ${plain(ex.soWhat)}`); P(`  (${T('Show in 3D', 'In 3D zeigen')}: ${showText(ex.show)})`); });
  question(U.flaw, T('Spot the flaw.', 'Finde den Fehler.'));
  P(T('\nIf both predictions were right (at any confidence), an optional "Go deeper" question appears:', '\nWaren beide Vorhersagen richtig (egal wie sicher), erscheint eine freiwillige Frage „Tiefer gehen“:'));
  question(U.deeper, T('Go deeper (optional).', 'Tiefer gehen (freiwillig).'));
  H(T('Step 6 of 7 · Explain back', 'Schritt 6 von 7 · Erklären') + left(5));
  P(plain(U.explain.prompt));
  P(explainHow);
  U.explain.ideas.forEach((i) => P(`  ☐ ${plain(i.idea)}`));
  k.push(`- ${T('Tightened version', 'Musterformulierung')}: ${plain(U.explain.tightened)}`);
  H(T('Step 7 of 7 · Wrap-up', 'Schritt 7 von 7 · Abschluss') + left(6));
  P(T('A summary of each concept with level and next review date; then the reading. Term pairs only if the second language is on.', 'Eine Übersicht je Konzept mit Stufe und nächstem Wiederholungsdatum; dann der Lesestoff. Begriffspaare nur, wenn die zweite Sprache an ist.'));
  readingsOut(U.readings);
}
const tag = units.join('');
writeFileSync(`${out}/script-u${tag}-${lang}.md`, q.join('\n') + '\n');
writeFileSync(`${out}/feedback-key-u${tag}-${lang}.md`, `# ${T('Feedback key', 'Feedback-Schlüssel')}\n` + k.join('\n') + '\n');
console.log('written', `${out}/script-u${tag}-${lang}.md`, q.length, 'lines;', k.length, 'feedback entries');
